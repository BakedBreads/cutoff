<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget wears the same clothes as the app: paper ground, 2px ink border,
  a grey block offset behind it standing in for the hard shadow, monospace type.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- hard shadow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/cutoff_widget_shadow" />

    <!-- panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/cutoff_widget_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- eyebrow rule -->
        <View
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:background="@drawable/cutoff_widget_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#6B6B6B"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="CUTOFF" />

            <TextView
                android:id="@+id/widget_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0A0A0A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:visibility="gone"
                android:text="LOCKED" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="#0A0A0A"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="34sp"
            android:text="READY" />

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#6B6B6B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="TAP TO START A SESSION" />
    </LinearLayout>
</FrameLayout>
